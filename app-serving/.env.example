# Copy to app-serving/.env only to change the defaults below; the bridge and the
# replayer both read it. The platform key and endpoint are read from the REPO's
# .env (ATAI_API_KEY, ATAI_API_ENDPOINT=https://api.dev.u1.archetypeai.app), the
# same file the Python stages use; an ATAI_* line here is ignored. Nothing here
# is needed to run the app.

# optional: which incident the replayer starts on, and its speed ceiling
# SLICE=inc04
# SPEED=250

# optional: ports, if something else holds the defaults (1891 · 9009 · 9101 · 5181).
# mosquitto/mosquitto.conf and package.json pin them for `npm run dev`.
# MQTT_PORT=1891
# AGENT_PORT=9101
