{
  "name": "red-pump-monitor-serving",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n broker,agent,replayer,web -c blue,magenta,yellow,green \"npm run broker\" \"npm run agent\" \"npm run replayer\" \"vite dev --port 5181 --strictPort\"",
    "web": "vite dev --port 5181 --strictPort",
    "broker": "sh scripts/run-broker.sh",
    "agent": "node scripts/serving-bridge.js --app red-serving",
    "replayer": "node scripts/replayer.js --app red-serving",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "stop": "sh scripts/stop.sh"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.575.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "bits-ui": "^2.17.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "layerchart": "^2.0.0-next.43",
    "svelte": "^5.55.2",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@archetypeai/ds-lib-tokens": "^0.10.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "d3-contour": "^4.0.2",
    "mode-watcher": "^1.1.0",
    "mqtt": "^5.10.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  }
}
